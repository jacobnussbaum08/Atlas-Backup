# =============================================================================
# Atlas AI Trader — environment configuration
#
# Copy to .env and adjust:   cp .env.example .env
# .env is git-ignored. Never commit real credentials.
#
# Every ATLAS_* variable below is read and validated by the backend at startup
# (backend/app/core/config/settings.py). Unknown ATLAS_* keys in .env are
# rejected, so typos fail fast instead of silently using a default.
#
# Atlas is PAPER-TRADING ONLY. There is deliberately no setting that enables
# live trading or selects a real broker.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | test | paper
#   paper: rejects the development default passwords below and DEBUG logging.
ATLAS_ENVIRONMENT=development
# Service name used in logs and as the PostgreSQL application_name.
ATLAS_SERVICE_NAME=atlas-ai-trader
# Interface/port the API binds to when run with `python -m app`.
# (Docker Compose overrides the host to 0.0.0.0 inside the container.)
ATLAS_API_HOST=127.0.0.1
ATLAS_API_PORT=8000
# Comma-separated browser origins allowed to call the API directly.
# Empty is fine for local use: the dashboard dev server proxies API calls.
ATLAS_CORS_ORIGINS=

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
ATLAS_LOG_LEVEL=INFO
# true: one JSON object per line (UTC timestamps). false: human-readable console.
ATLAS_LOG_JSON=true

# --- PostgreSQL (source of truth) --------------------------------------------
# Host used when running the backend directly on your machine.
# Docker Compose overrides this to the "postgres" service for containers.
ATLAS_POSTGRES_HOST=127.0.0.1
ATLAS_POSTGRES_PORT=5432
ATLAS_POSTGRES_DB=atlas
ATLAS_POSTGRES_USER=atlas
# Development default only. Must be changed for ATLAS_ENVIRONMENT=paper.
ATLAS_POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
# Connection pool size and overflow per process.
ATLAS_DB_POOL_SIZE=5
ATLAS_DB_MAX_OVERFLOW=5
# Seconds to wait when opening a connection.
ATLAS_DB_CONNECT_TIMEOUT_SECONDS=5
# Server-side limit for any single statement, in milliseconds.
ATLAS_DB_STATEMENT_TIMEOUT_MS=30000

# --- Redis (cache / coordination only; never authoritative) ------------------
# Must not contain credentials; use ATLAS_REDIS_PASSWORD.
ATLAS_REDIS_URL=redis://127.0.0.1:6379/0
# Optional. When set, Docker Compose also starts Redis with this password.
ATLAS_REDIS_PASSWORD=
# Socket connect/read timeout in seconds.
ATLAS_REDIS_TIMEOUT_SECONDS=2.0

# --- Docker Compose host ports (read by docker-compose.yml, not the backend) --
# Ports are published on 127.0.0.1 only. Change these if they collide with
# services already running on your machine.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# --- Tests (set in your shell or CI, not needed in .env) ---------------------
# ATLAS_TEST_DATABASE_URL=postgresql+psycopg://atlas:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/postgres
#     Server where integration tests may CREATE/DROP throw-away databases.
# ATLAS_TEST_REDIS_URL=redis://127.0.0.1:6379/15
#     Redis used by the Redis integration test (keys are namespaced and deleted).
# ATLAS_REQUIRE_INTEGRATION=1
#     Fail (instead of skip) integration tests whose server is not configured.

# --- Market data provider (Phase 2; not yet read by the backend) -------------
# Alpaca MARKET-DATA credentials. Put real values only in your local .env,
# never here. Atlas uses Alpaca for market data only, never for orders.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# iex = free Basic plan (IEX exchange only, NOT consolidated US volume)
# sip = consolidated feed (paid subscription). Never switched automatically.
ALPACA_DATA_FEED=iex
MARKET_DATA_PROVIDER=alpaca
