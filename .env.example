# =============================================================================
# Atlas AI Trader — environment configuration
#
# Copy to .env and adjust:   cp .env.example .env
# .env is git-ignored. Never commit real credentials.
#
# Every ATLAS_* variable below is read and validated by the backend at startup
# (backend/app/core/config/settings.py). Unknown ATLAS_* keys in .env are
# rejected, so typos fail fast instead of silently using a default.
#
# Atlas is PAPER-TRADING ONLY. There is deliberately no setting that enables
# live trading or selects a real broker.
# =============================================================================

# --- Application -------------------------------------------------------------
# development | test | paper
#   paper: rejects the development default passwords below and DEBUG logging.
ATLAS_ENVIRONMENT=development
# Service name used in logs and as the PostgreSQL application_name.
ATLAS_SERVICE_NAME=atlas-ai-trader
# Interface/port the API binds to when run with `python -m app`.
# (Docker Compose overrides the host to 0.0.0.0 inside the container.)
ATLAS_API_HOST=127.0.0.1
ATLAS_API_PORT=8000
# Comma-separated browser origins allowed to call the API directly.
# Empty is fine for local use: the dashboard dev server proxies API calls.
ATLAS_CORS_ORIGINS=
# Shared secret for operational endpoints (e.g. POST /api/v1/market-data/historical-fetch),
# sent as the X-Atlas-Operator-Token header. Empty: allowed only in development/test,
# refused in the paper environment. Generate e.g. with: python -c "import secrets;print(secrets.token_urlsafe(32))"
ATLAS_OPERATOR_TOKEN=

# --- Logging -----------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL
ATLAS_LOG_LEVEL=INFO
# true: one JSON object per line (UTC timestamps). false: human-readable console.
ATLAS_LOG_JSON=true

# --- PostgreSQL (source of truth) --------------------------------------------
# Host used when running the backend directly on your machine.
# Docker Compose overrides this to the "postgres" service for containers.
ATLAS_POSTGRES_HOST=127.0.0.1
ATLAS_POSTGRES_PORT=5432
ATLAS_POSTGRES_DB=atlas
ATLAS_POSTGRES_USER=atlas
# Development default only. Must be changed for ATLAS_ENVIRONMENT=paper.
ATLAS_POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
# Connection pool size and overflow per process.
ATLAS_DB_POOL_SIZE=5
ATLAS_DB_MAX_OVERFLOW=5
# Seconds to wait when opening a connection.
ATLAS_DB_CONNECT_TIMEOUT_SECONDS=5
# Server-side limit for any single statement, in milliseconds.
ATLAS_DB_STATEMENT_TIMEOUT_MS=30000

# --- Redis (cache / coordination only; never authoritative) ------------------
# Must not contain credentials; use ATLAS_REDIS_PASSWORD.
ATLAS_REDIS_URL=redis://127.0.0.1:6379/0
# Optional. When set, Docker Compose also starts Redis with this password.
ATLAS_REDIS_PASSWORD=
# Socket connect/read timeout in seconds.
ATLAS_REDIS_TIMEOUT_SECONDS=2.0

# --- Docker Compose host ports (read by docker-compose.yml, not the backend) --
# Ports are published on 127.0.0.1 only. Change these if they collide with
# services already running on your machine.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
API_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# --- Tests (set in your shell or CI, not needed in .env) ---------------------
# ATLAS_TEST_DATABASE_URL=postgresql+psycopg://atlas:CHANGE_ME_LOCAL_ONLY@127.0.0.1:5432/postgres
#     Server where integration tests may CREATE/DROP throw-away databases.
# ATLAS_TEST_REDIS_URL=redis://127.0.0.1:6379/15
#     Redis used by the Redis integration test (keys are namespaced and deleted).
# ATLAS_REQUIRE_INTEGRATION=1
#     Fail (instead of skip) integration tests whose server is not configured.

# --- Market data (Phase 2) -----------------------------------------------------
# Validated at startup (backend/app/core/config/market_data.py). Unknown
# MARKET_DATA_* / HISTORICAL_DATA_* / ALPACA_* keys are rejected as typos.

# Provider adapter to use. Registered providers: alpaca
MARKET_DATA_PROVIDER=alpaca
# Initial universe as comma-separated Atlas symbols. Not hard-coded anywhere;
# each symbol needs an entry in config/market_data/reference_assets.toml.
# Phase 2B starts with AAPL,SPY; QQQ,MSFT,NVDA are added after they pass acceptance.
MARKET_DATA_SYMBOLS=AAPL,SPY
# Live WebSocket streaming (stream-worker service). Off until credentials and symbols
# are configured and the symbols are registered (register-assets).
MARKET_DATA_STREAM_ENABLED=false
# Upper bound of the exponential reconnect backoff, in seconds.
MARKET_DATA_RECONNECT_MAX_DELAY=60
# Seconds without a WebSocket pong (or any frame) before the connection is replaced.
MARKET_DATA_HEARTBEAT_TIMEOUT=30
# Live channels for every symbol: bars, updated_bars, daily_bars, trades, quotes.
MARKET_DATA_STREAM_CHANNELS=bars,updated_bars,trades,quotes
# Received frames buffered before the database writer; overflow is recorded, never silent.
MARKET_DATA_STREAM_QUEUE_SIZE=10000
# Regular-session seconds without a persisted observation before health reports STALE.
MARKET_DATA_STREAM_STALE_AFTER=180
# Bars requested per historical page (Alpaca maximum: 10000).
HISTORICAL_DATA_BATCH_SIZE=1000
# Retries for transient historical-request failures (never for rejected credentials).
HISTORICAL_DATA_MAX_RETRIES=5
# Price adjustment requested for historical bars: RAW | SPLIT | DIVIDEND | SPIN_OFF | ALL.
# RAW = as traded (not adjusted for splits/dividends). Series with different
# adjustments are stored and served separately, never mixed.
HISTORICAL_DATA_ADJUSTMENT=RAW
# Safety bound on pages per symbol request; exceeding it fails the symbol loudly.
HISTORICAL_DATA_MAX_PAGES=1000

# --- Deliverable 2D: completeness monitoring and recovery
# Off by default: when enabled, the recovery worker requests the provider's history.
MARKET_DATA_RECOVERY_ENABLED=false
# Seconds between recovery cycles.
MARKET_DATA_RECOVERY_INTERVAL=60
# Bar timeframes whose completeness is tracked (intraday or 1Day).
MARKET_DATA_RECOVERY_TIMEFRAMES=1Min,1Day
# Data types recovered from history: bars, trades, quotes. Quotes are very high volume;
# without them, quote gaps stay reported as missing.
MARKET_DATA_RECOVERY_DATA_TYPES=bars,trades
# Days back (New York calendar) that the completeness scan examines.
MARKET_DATA_COMPLETENESS_LOOKBACK_DAYS=5
# Seconds after an interval ends before its history is requested.
MARKET_DATA_RECOVERY_SETTLE_SECONDS=120
# Attempts per recovery job before it is FAILED.
MARKET_DATA_RECOVERY_MAX_ATTEMPTS=5
# Window (minutes) for reconciling live trades with the provider's trade history.
MARKET_DATA_TRADE_RECONCILIATION_MINUTES=30
# Live quotes/trades delivered this many seconds after the event are stored STALE (0 = off).
MARKET_DATA_STALE_OBSERVATION_SECONDS=60

# --- Alpaca (market data only) ---------------------------------------------------
# Alpaca MARKET-DATA credentials. Put real values only in your local .env,
# never here. Atlas uses Alpaca for market data, plus one read-only exception
# (Phase 3A, decision D-050): GET /v2/assets on the PAPER Trading API host for
# the instrument directory. It never calls order, account or position endpoints
# and never the live trading host. Use paper-account keys.
# Leave both empty to run without market data; setting only one is an error.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# iex         = IEX exchange only (free Basic plan). NOT consolidated US volume.
# sip         = consolidated feed of all US exchanges (real-time needs Algo Trader Plus).
# delayed_sip = 15-minute delayed SIP (streaming; not assumed available, see docs).
# The feed is never switched automatically, and every stored record names its feed.
ALPACA_DATA_FEED=iex
# Your Alpaca market-data subscription: basic | algo_trader_plus
ALPACA_DATA_PLAN=basic
# Timeout for one market-data HTTP request, in seconds.
ALPACA_REQUEST_TIMEOUT_SECONDS=15

# --- Asset discovery (Phase 3A) ----------------------------------------------------
# Unknown ASSET_DISCOVERY_* keys are rejected as typos. Thresholds and ranking weights
# are NOT here: they are versioned, audited database configuration (/api/v1/discovery/config).
# Background worker (python -m app.workers.asset_discovery). Off by default: it reads the
# provider's asset directory on a schedule.
ASSET_DISCOVERY_ENABLED=false
# Seconds between worker cycles.
ASSET_DISCOVERY_POLL_INTERVAL=60
# Full directory listing (every status; detects disappearances), in hours.
ASSET_DISCOVERY_FULL_INTERVAL_HOURS=168
# Active-only listing (new listings, changes) between full listings, in hours.
ASSET_DISCOVERY_INCREMENTAL_INTERVAL_HOURS=24
# Bounded single-asset reference refresh (watchlist and qualified first), in hours / count.
ASSET_DISCOVERY_REFRESH_INTERVAL_HOURS=12
ASSET_DISCOVERY_REFRESH_MAX_ASSETS=100
# Known-active instruments absent from an active-only listing, looked up one by one per job.
ASSET_DISCOVERY_VERIFY_MISSING_MAX=200
# Qualification + scoring pipeline cadence, in hours.
ASSET_DISCOVERY_QUALIFICATION_INTERVAL_HOURS=24
# Mapping start assumed for instruments first seen active whose symbol no other known
# instrument uses (start of Alpaca's documented stock history, as D-026).
ASSET_DISCOVERY_ASSUMED_HISTORY_START=2016-01-01
# Directory records per database transaction.
ASSET_DISCOVERY_CHUNK_SIZE=500
# Attempts per job (transient failures are retried with backoff) and the job lease.
ASSET_DISCOVERY_JOB_MAX_ATTEMPTS=3
ASSET_DISCOVERY_JOB_LEASE_SECONDS=900
# Rule set and scoring version codes ("auto" = us-equity-<feed>).
ASSET_DISCOVERY_RULE_SET=auto
ASSET_DISCOVERY_SCORING_VERSION=watchlist-default
# Daily history retrieved per qualification job for eligible instruments without it
# (0 = off), and how many calendar days back. Bounded: never the whole pool.
ASSET_DISCOVERY_HISTORY_PREP_MAX_ASSETS=200
ASSET_DISCOVERY_HISTORY_PREP_LOOKBACK_DAYS=130
# Benchmark for relative strength (an Atlas symbol with daily history).
ASSET_DISCOVERY_BENCHMARK_SYMBOL=SPY
