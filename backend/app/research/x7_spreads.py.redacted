# ruff: noqa: E501  (query text and provenance read as one row each)
"""X7 (D-256): measured historical SIP quoted spreads as a pinned, point-in-time input.

**Why.** X6's spread estimate (the Abdi-Ranaldo close-high-low estimator, each two-day value
truncated at zero before averaging) was checked against the quoted spreads Atlas measured
from historical SIP quotes for the same tickers and sessions (2017-2019,
``spread-sample-open-v1`` and ``spread-sample-v1``, ``backtesting.spreads``). It overstates
REDACTED_FOR_GITHUB
REDACTED_FOR_GITHUB
REDACTED_FOR_GITHUB
REDACTED_FOR_GITHUB
measurements, which are evidence, and keeps X6's estimate as a pessimistic sensitivity
scenario. :func:`calibration` reproduces the comparison and is stored with the results.

**Data.** ``capture`` reads (SELECT only) every OK SIP measurement with a window ending
before 2020 from ``asset_metric_values`` in the simulation database, joined to the asset's
symbol, and writes them once to ``config/simulation/evidence/x7/sip_quoted_spreads_2017_2019.json.gz``
with the query and the database name. The file is pinned by SHA-256.

**Use.** ``MeasuredSpreads.at(ticker, asof)``: the newest measurement of the execution's
window kind (``60s@open+1m`` for opening executions, ``60s@close-15m`` otherwise) whose
window ended by the decision's close and is at most ``MAX_AGE_DAYS`` old. The measurement is
keyed by the symbol as of its session, as the X4.5 bars are (provider ``asof`` symbology). A
measurement is a one-minute sample, not the quote at the fill: a stated limitation.
"""

from __future__ import annotations

import bisect
import hashlib
import itertools
import math
import statistics
from collections import defaultdict
from datetime import UTC, datetime, timedelta
from decimal import Decimal
from pathlib import Path
from typing import Any

from app.research import x4_evidence as x4
from app.research import x6_data as xd
from app.research import x6_execution as ex

PATH = Path("config/simulation/evidence/x7/sip_quoted_spreads_2017_2019.json.gz")
SHA256 = "d380348428c7172d87c854f9a1f76d6526c8681cd873009d1c38cb583cbd079c"
MAX_AGE_DAYS = 45
OPEN_WINDOW = "60s@open+1m"
CLOSE_WINDOW = "60s@close-15m"
QUERY = (
    'SELECT a.symbol, v."window", v.feature_version, v.source_start, v.source_end, v.value, v.observations '
    "FROM asset_metric_values v JOIN assets a ON a.id = v.asset_id "
    "WHERE v.metric = 'quoted_spread_bps' AND v.feed = 'sip' AND v.status = 'OK' "
    "AND v.source_end < '2020-01-01' ORDER BY a.symbol, v.\"window\", v.source_end, v.id"
)


def capture(factory: Any, database: str) -> dict[str, Any]:
    """Read the measurements once (SELECT only) and write the evidence file once."""
    from sqlalchemy import text

    if PATH.exists():
        raise FileExistsError(f"{PATH} exists: written once")
    with factory() as session:
        rows = session.execute(text(QUERY)).all()
    data = [
        [
            r[0],
            r[1],
            r[2],
            r[3].astimezone(UTC).isoformat(),
            r[4].astimezone(UTC).isoformat(),
            str(r[5]),
            r[6],
        ]
        for r in rows
    ]
    doc = {"kind": "x7_sip_quoted_spreads", "decision": "D-256", "database": database, "query": QUERY,
           "columns": ["symbol", "window", "feature_version", "source_start", "source_end", "value_bps", "quotes"],
           "rows": data, "note": "Measured by backtesting.spreads from historical SIP quotes (time-weighted median of a 60-second window); one sample per asset and month and window kind. Read-only extraction."}  # fmt: skip
    PATH.parent.mkdir(parents=True, exist_ok=True)
    raw = x4.gz(x4.canonical(doc))
    PATH.write_bytes(raw)
    return {"path": PATH.as_posix(), "rows": len(data), "sha256": hashlib.sha256(raw).hexdigest()}


class MeasuredSpreads:
    """Pinned measurements, served point in time."""

    def __init__(self, rows: list[list[Any]], window: str) -> None:
        self.window = window
        self._by: dict[str, tuple[list[datetime], list[Decimal]]] = {}
        grouped: dict[str, list[tuple[datetime, Decimal]]] = defaultdict(list)
        for sym, win, _fv, _start, end, value, _q in rows:
            if win == window:
                grouped[sym].append((datetime.fromisoformat(end), Decimal(value)))
        for sym, items in grouped.items():
            items.sort()
            self._by[sym] = ([t for t, _ in items], [v for _, v in items])

    @classmethod
    def load(cls, window: str) -> MeasuredSpreads:
        raw = PATH.read_bytes()
        if hashlib.sha256(raw).hexdigest() != SHA256:
            raise xd.PinError(f"{PATH}: not the pinned spread measurements")
        return cls(x4.read_json(PATH)["rows"], window)

    def at(self, ticker: str, asof: str) -> tuple[Decimal, str] | None:
        """(spread bps, measurement end) of the newest measurement known at ``asof``'s close."""
        found = self._by.get(ticker)
        if not found:
            return None
        from app.research.x7_signals import _utc

        close = _utc(asof)[1]
        i = bisect.bisect_right(found[0], close) - 1
        if i < 0 or close - found[0][i] > timedelta(days=MAX_AGE_DAYS):
            return None
        return found[1][i], found[0][i].isoformat()


def window_for(timing: ex.Timing) -> str:
    return OPEN_WINDOW if timing == ex.Timing.NEXT_OPEN else CLOSE_WINDOW


def _ar(bars: list[xd.Bar], truncate_pairs: bool) -> float | None:
    pairs = [(a, b) for a, b in itertools.pairwise(bars) if ex.next_session(a.session) == b.session]
    if len(pairs) < 10:
        return None
    vals = []
    for a, b in pairs:
        c = math.log(float(a.close))
        vals.append(4 * (c - (math.log(float(a.high)) + math.log(float(a.low))) / 2)
                    * (c - (math.log(float(b.high)) + math.log(float(b.low))) / 2))  # fmt: skip
    if truncate_pairs:
        return math.sqrt(sum(max(v, 0.0) for v in vals) / len(vals)) * 1e4
    return math.sqrt(max(sum(vals) / len(vals), 0.0)) * 1e4


def calibration(market: xd.Market) -> dict[str, Any]:
    """X6's estimator (and the averaged variant) against the measurements, per window kind:
    the estimate from the 21 executable bars ending at the measurement's session."""
    rows = x4.read_json(PATH)["rows"]
    by_ticker: dict[str, list[xd.SlotData]] = defaultdict(list)
    for sd in market.slots.values():
        if sd.has_series:
            by_ticker[sd.ticker].append(sd)
    out: dict[str, Any] = {}
    for window in (OPEN_WINDOW, CLOSE_WINDOW):
        pairs: dict[str, list[tuple[float, float]]] = {
            "x6_pairwise_truncated": [],
            "averaged_then_truncated": [],
        }
        for sym, win, _fv, _start, end, value, _q in rows:
            if win != window:
                continue
            day = datetime.fromisoformat(end).astimezone(xd_tz()).date().isoformat()
            for sd in by_ticker.get(sym, []):
                if not sd.executable(day):
                    continue
                hist = market.history(sd.slot, day)[-21:]
                if len(hist) == 21 and hist[-1].session == day:
                    for name, trunc in (
                        ("x6_pairwise_truncated", True),
                        ("averaged_then_truncated", False),
                    ):
                        e = _ar(hist, trunc)
                        if e is not None:
                            pairs[name].append((e, float(value)))
                break
        measured = [b for _, b in pairs["x6_pairwise_truncated"]]
        res: dict[str, Any] = {"matched": len(measured)}
        if measured:
            res["measured"] = _summary(measured)
            for name, p in pairs.items():
                est = [a for a, _ in p]
                res[name] = {**_summary(est),
                             "median_ratio_to_measured": round(statistics.median(a / b for a, b in p if b > 0), 3),
                             "log_correlation": round(statistics.correlation([math.log(max(a, 0.5)) for a, _ in p],
                                                                             [math.log(max(b, 0.5)) for _, b in p]), 3)}  # fmt: skip
        out[window] = res
    return out


def _summary(v: list[float]) -> dict[str, float]:
    return {"median_bps": round(statistics.median(v), 3), "p90_bps": round(statistics.quantiles(v, n=10)[-1], 3),
            "share_above_50_bps": round(sum(x > 50 for x in v) / len(v), 4)}  # fmt: skip


def xd_tz() -> Any:
    from app.data_engine.timeframes import US_EQUITY_TIMEZONE

    return US_EQUITY_TIMEZONE
